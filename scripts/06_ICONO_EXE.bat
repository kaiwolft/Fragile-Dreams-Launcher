@echo off
title Fragile Dreams - icono de FragileDreams.exe
rem Cambia el icono del motor (Electron) por el loto del juego aplicando launcher\data\icono_exe.bin.
rem Mismo metodo que CAMBIAR_ICONO_EXE.bat de Pandora's Tower. Cierra el launcher antes.
set "FDROOT=%~dp0.."
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; try { $r=(Resolve-Path $env:FDROOT).Path; $exe=Join-Path $r 'launcher\FragileDreams.exe'; $pat=Join-Path $r 'launcher\data\icono_exe.bin'; if (Get-Process FragileDreams -ErrorAction SilentlyContinue) { throw 'Cierra el launcher primero.' }; $md5=(Get-FileHash $exe -Algorithm MD5).Hash; if ($md5 -eq '72C9C6F289FC79E41D22AAC36385AD27' -or $md5 -eq 'C17F3275C2E892944EEDD206951290A0') { Write-Host 'El icono ya estaba cambiado.' } else { if ($md5 -ne '0A051D6D4B6C355F0297FB56BA2C61D0') { throw ('FragileDreams.exe no es la version esperada (' + $md5 + ')') }; Copy-Item $exe ($exe + '.bak') -Force; $p=[IO.File]::ReadAllBytes($pat); $fs=[IO.File]::Open($exe,'Open','ReadWrite'); try { $n=[BitConverter]::ToUInt32($p,4); $o=8; for($i=0;$i -lt $n;$i++){ $off=[BitConverter]::ToUInt32($p,$o); $len=[BitConverter]::ToUInt32($p,$o+4); $o+=8; [void]$fs.Seek($off,'Begin'); $fs.Write($p,$o,$len); $o+=$len } } finally { $fs.Close() }; $md5=(Get-FileHash $exe -Algorithm MD5).Hash; if ($md5 -ne '72C9C6F289FC79E41D22AAC36385AD27') { Copy-Item ($exe + '.bak') $exe -Force; throw 'La comprobacion fallo; se restauro el original.' }; Remove-Item ($exe + '.bak') -Force; Write-Host 'Icono cambiado.' }; (Get-Item $exe).LastWriteTime = Get-Date; Start-Process ie4uinit.exe -ArgumentList '-show' -ErrorAction SilentlyContinue; Write-Host 'Listo. Si Windows sigue mostrando el icono viejo, espera unos segundos o reinicia el Explorador.' } catch { Write-Host ('ERROR: ' + $_.Exception.Message) -ForegroundColor Red }"
pause
